{
    "version": "0.2.0",
    "configurations": [
        {
            // F5: baut die gerade im Editor aktive .c-Datei und startet sie in VICE.
            //
            // Der Typ "node-terminal" ist hier nur das Vehikel, um per F5 einen
            // Befehl auszufuehren - es ist kein JavaScript im Spiel. VS64s eigener
            // Debugger kommt bewusst nicht zum Einsatz: er laedt immer das in
            // project-config.json eingetragene Programm und kann der aktiven Datei
            // nicht folgen.
            //
            // Quellcode-Debugging mit Breakpoints gibt es, wenn der jeweilige
            // Programmordner (main/ oder pacman/) direkt als Ordner geoeffnet wird -
            // dort greift dann dessen eigene launch.json.
            "type": "node-terminal",
            "request": "launch",
            "name": "Plus/4: Aktive .c-Datei bauen & starten",
            "command": "${workspaceFolder}/.vscode/run-current.sh '${file}'",
            "cwd": "${workspaceFolder}"
        },
        {
            // Wie oben, nur in Yape statt VICE (dessen TED ist naeher am
            // echten Chip). Bringt das Programm ein run-yape.sh mit, startet
            // das - Paradroid: von seiner Diskette, mit dem Gamepad.
            // Welche Konfiguration F5 nimmt, waehlt man oben in der Ansicht
            // "Ausfuehren und Debuggen"; F5 bleibt dann bei ihr.
            "type": "node-terminal",
            "request": "launch",
            "name": "Plus/4: Aktive .c-Datei bauen & in Yape starten",
            "command": "PLUS4_EMU=yape ${workspaceFolder}/.vscode/run-current.sh '${file}'",
            "cwd": "${workspaceFolder}"
        }
    ]
}
