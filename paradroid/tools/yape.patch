+/* ---------- test hooks (Paradroid's tests): SIGUSR1 enters the monitor,
+   which reads its commands from stdin; SIGUSR2 saves a screenshot to
+   $YAPE_SHOT ---------- */
+#include <signal.h>
+static volatile sig_atomic_t g_sigMon = 0, g_sigShot = 0;
+static void onSigMon(int) { g_sigMon = 1; }
+static void onSigShot(int) { g_sigShot = 1; }
+
+static void testHooks()
+{
+	if (g_sigMon) {
+		g_sigMon = 0;
+		monitorEnter(machine);
+		printf("MONITOR LEFT\n");
+	}
+	// $YAPE_SHOTN pictures in a row, one a frame: $YAPE_SHOT.000 on
+	static int shotLeft = 0, shotIdx = 0, shotSeries = 0;
+	if (g_sigShot) {
+		g_sigShot = 0;
+		const char *n = getenv("YAPE_SHOTN");
+		shotLeft = n ? atoi(n) : 1;
+		shotSeries = n != NULL;
+		shotIdx = 0;
+		// $YAPE_WAV: the sound of the series too, raw (sound.cpp)
+		extern FILE *g_audioRec;
+		const char *w = getenv("YAPE_WAV");
+		if (w && shotSeries && !g_audioRec)
+			g_audioRec = fopen(w, "wb");
+	}
+	if (shotLeft) {
+		shotLeft--;
+		// the TED's own picture, as a PPM (not the renderer's, whose
+		// buffer is undefined after presenting)
+		const char *f0 = getenv("YAPE_SHOT");
+		char f[1024], tmp[1100];
+		FILE *fp = NULL;
+		if (f0) {
+			if (shotSeries)
+				snprintf(f, sizeof f, "%s.%03d", f0, shotIdx++);
+			else
+				snprintf(f, sizeof f, "%s", f0);
+			snprintf(tmp, sizeof tmp, "%s.tmp", f);
+			fp = fopen(tmp, "wb");
+		}
+		if (fp) {
+			const unsigned int cpr = ted8360->getCyclesPerRow();
+			const unsigned char *src = ted8360->getScreenData() + (cpr - 384 - 8) / 2;
+			const unsigned int *pal = palette_get_rgb();
+			fprintf(fp, "P6\n%d %d\n255\n", SCREENX, SCREENY);
+			for (unsigned int y = 0; y < SCREENY; y++)
+				for (unsigned int x = 0; x < SCREENX; x++) {
+					unsigned int c = pal[src[y * cpr + x]];
+					fputc((c >> 16) & 255, fp);
+					fputc((c >> 8) & 255, fp);
+					fputc(c & 255, fp);
+				}
+			fclose(fp);
+			rename(tmp, f);
+			if (!shotLeft) {
+				extern FILE *g_audioRec;
+				if (g_audioRec) {
+					fclose(g_audioRec);
+					g_audioRec = NULL;
+				}
+				printf("SHOT SAVED %s\n", f);
+			}
+		} else {
+			shotLeft = 0;
+			printf("SHOT FAILED\n");
+		}
+	}
+}
+
+/* YAPE_SHM: a file a test maps as well (simple-soccer/tests/yape.py):
+   0, 1    joystick 1's and 2's bits, for keyboard.cpp's feedjoy
+   2       bit 0: warp wanted
+   4-7     the frames allowed to run (little endian; $FFFFFFFF: no limit)
+   8-11    the frames run (written here)
+   12-15   the frame the memory copy was made at (written here)
+   $100-   the memory as the CPU sees it, copied when the frames allowed
+           are done ($FD00-$FEFF and $FF20-$FF3F left out: I/O)
+   The machine stands still between frames till the test allows more. */
+#include <sys/mman.h>
+#include <fcntl.h>
+#include <unistd.h>
+volatile unsigned char *g_yapeShm = NULL;
+#define SHM_SIZE 0x10100
+
+static unsigned int shmWord(unsigned int at)
+{
+	return g_yapeShm[at] | (g_yapeShm[at + 1] << 8) | (g_yapeShm[at + 2] << 16)
+		| ((unsigned int) g_yapeShm[at + 3] << 24);
+}
+
+static void shmSetWord(unsigned int at, unsigned int v)
+{
+	for (int i = 0; i < 4; i++)
+		g_yapeShm[at + i] = (v >> (8 * i)) & 255;
+}
+
+// true: the frames allowed are done, no frame now
+static bool shmHold()
+{
+	static int tried = 0;
+	if (!tried) {
+		tried = 1;
+		const char *p = getenv("YAPE_SHM");
+		int fd = p ? open(p, O_RDWR) : -1;
+		if (fd >= 0) {
+			void *m = mmap(NULL, SHM_SIZE, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+			if (m != MAP_FAILED)
+				g_yapeShm = (volatile unsigned char *) m;
+			close(fd);
+		}
+	}
+	if (!g_yapeShm)
+		return false;
+	const bool warp = g_yapeShm[2] & 1;
+	if (warp == g_50Hz)
+		toggleFullThrottle(NULL);
+	const unsigned int allowed = shmWord(4), done = shmWord(8);
+	if (allowed == 0xFFFFFFFF || done < allowed) {
+		shmSetWord(8, done + 1);
+		return false;
+	}
+	if (shmWord(12) != done) {
+		MemoryHandler &mem = machine->getMem();
+		for (unsigned int a = 0; a < 0x10000; a++)
+			if (a < 0xFD00 || (a >= 0xFF00 && a < 0xFF20) || a >= 0xFF40)
+				g_yapeShm[0x100 + a] = mem.Read(a);
+		__sync_synchronize();
+		shmSetWord(12, done);
+	}
+	return true;
+}
