{
    // VS Code laeuft hier als Flatpak. cc65 und VICE sind auf dem Host installiert
    // und daher nur ueber die Shim-Skripte in ~/.local/share/cc65-vs64/bin erreichbar.
    "vs64.cc65InstallDir": "/home/min/.local/share/cc65-vs64",
    // Nicht der Emulator selbst, sondern ein Vorschalt-Skript: es startet den
    // Proxy, haengt die ACIA an dessen Socket und ruft dann das echte xplus4
    // mit allem auf, was VS64 uebergibt. Ohne Proxy zeigt der Client nichts an.
    "vs64.viceExecutable": "/home/min/Dokumente/Development/Plus4/pokerth/client/vice-with-proxy.sh",
    "vs64.vicePort": "6502",
    // Nach dem Speichern automatisch neu bauen.
    "vs64.autoBuild": true
}
